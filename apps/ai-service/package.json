{
  "name": "@artify/ai-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "poetry build",
    "dev": "poetry run uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "poetry run uvicorn src.main:app --host 0.0.0.0 --port 8000",
    "lint": "poetry run ruff check .",
    "typecheck": "poetry run mypy .",
    "test": "poetry run pytest",
    "docker:build": "docker build -t artify-ai-service .",
    "docker:push": "docker push artify-ai-service"
  },
  "dependencies": {
    "fastapi": "^0.115.0",
    "uvicorn": "^0.24.0",
    "pydantic": "^2.5.0",
    "httpx": "^0.25.0",
    "python-multipart": "^0.0.6",
    "pillow": "^10.1.0",
    "openai": "^1.5.0",
    "pinecone-client": "^3.0.0",
    "redis": "^5.0.0"
  },
  "devDependencies": {
    "ruff": "^0.1.0",
    "mypy": "^1.7.0",
    "pytest": "^7.4.0",
    "black": "^23.0.0"
  }
}